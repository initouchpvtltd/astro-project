# Copy to .env and fill in. Never commit the real .env.

# Free account from geonames.org, with web services enabled in the
# account settings.
GEONAMES_USERNAME=

# Rate limits. Omit to use the defaults, or set to 0 to disable one.
# RATE_LIMIT_CITIES_PER_MINUTE=20
# RATE_LIMIT_CHART_PER_MINUTE=60
# GEONAMES_MAX_PER_HOUR=500
